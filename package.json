{
  "name": "octaspace-js-sdk",
  "private": true,
  "description": "OctaSpace JavaScript/TypeScript SDK monorepo",
  "repository": {
    "type": "git",
    "url": "https://github.com/octaspace/js-sdk.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter './packages/*' run build",
    "dev": "pnpm --filter './packages/*' run dev",
    "typecheck": "pnpm --filter './packages/*' run typecheck",
    "lint": "biome check packages",
    "lint:fix": "biome check --write packages",
    "format": "biome format --write packages",
    "test": "pnpm --filter './packages/*' run test",
    "test:coverage": "pnpm --filter './packages/*' run test:coverage",
    "smoke": "pnpm --filter @octaspace/sdk smoke",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "changeset": "changeset",
    "version": "changeset version",
    "audit": "pnpm audit --audit-level high"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.16.1"
}
