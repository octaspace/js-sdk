{
  "name": "@octaspace/sdk-query",
  "version": "0.1.0",
  "description": "TanStack Query integration for the OctaSpace SDK",
  "keywords": [
    "octa",
    "octaspace",
    "sdk",
    "tanstack",
    "query",
    "framework-agnostic"
  ],
  "homepage": "https://github.com/octaspace/js-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/octaspace/js-sdk.git",
    "directory": "packages/sdk-query"
  },
  "license": "MIT",
  "author": "OctaSpace",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run test"
  },
  "peerDependencies": {
    "@octaspace/sdk": "workspace:^"
  },
  "devDependencies": {
    "@octaspace/sdk": "workspace:*",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
