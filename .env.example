# Copy this file to .env and fill in your values. Never commit .env to git.

# Account API key (octa_ak_…), issued in Cube under Profile → Credentials
OCTA_API_KEY=octa_ak_your_key_here

# Optional: API host (default: https://api-dev.octa.space, the next API test stand)
# OCTA_API_URL=https://api-dev.octa.space
