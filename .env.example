# Copy this file to .env and fill in your values. Never commit .env to git.

# API key of your OctaSpace account (octa_ak_…), created in the dashboard under
# Account → Credentials → API Keys
OCTA_API_KEY=octa_ak_your_key_here

# Optional: another API host (default: https://api-dev.octa.space)
# OCTA_API_URL=https://api-dev.octa.space
